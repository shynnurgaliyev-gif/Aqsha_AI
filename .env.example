# App
NODE_ENV=development
APP_NAME=aqsha-ai
APP_PORT=3000
APP_BASE_URL=http://localhost:3000
APP_TIMEZONE=Asia/Almaty

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=

# Database
DATABASE_URL=
DATABASE_DIRECT_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Voice / Audio
FFMPEG_PATH=ffmpeg
MAX_VOICE_FILE_SIZE_MB=10
TRIAL_VOICE_DAILY_LIMIT=10
TRIAL_VOICE_MAX_DURATION_SEC=90
PAID_VOICE_MAX_DURATION_SEC=90

# Jobs / Worker
JOB_POLL_INTERVAL_MS=3000
JOB_BATCH_SIZE=50
DAILY_RECOMMENDATION_DEFAULT_HOUR=9

# Admin
ADMIN_ENABLED=true
ADMIN_PORT=4000
ADMIN_SECRET=

# Logging
LOG_LEVEL=info

# Billing
BILLING_PROVIDER=stub
TRIAL_DAYS=7
MONTHLY_PRICE_KZT=800